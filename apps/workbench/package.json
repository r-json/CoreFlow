{
  "name": "@coreflow/workbench",
  "version": "0.1.0-alpha",
  "description": "CoreFlow Kit Workbench: compose, sign, inspect and verify signed claims for Soroban contracts in the browser.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm --prefix ../../packages/sdk ci && npm --prefix ../../packages/sdk run build && npm ci",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@coreflow/sdk": "file:../../packages/sdk",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
